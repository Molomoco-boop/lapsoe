# Copia este archivo a deploy/.env.duckdns y rellena tus datos.
# Crea el subdominio gratis en https://www.duckdns.org/

DUCKDNS_SUBDOMAIN=observatorio-es
DUCKDNS_TOKEN=pega-aqui-tu-token-uuid
# Dominio resultante: https://observatorio-es.duckdns.org

# Puerto interno de la app (Caddy escucha 80/443 públicamente)
FRONTEND_PORT=3000
BACKEND_PORT=8000
